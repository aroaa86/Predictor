# Tela das outras ligas
<OutrasLigas>:
    name: 'outras'
    MDFloatLayout:
        md_bg_color: .3, .5, 0, .2

        MDTopAppBar:
            title: 'outras ligas'
            md_bg_color: 0, .4, 1, .3
            elevation: 10
            pos_hint: {'top': 1}
            left_action_items: [['arrow-left', lambda x:root.set_screen()]]

        MDCard:
            id: card
            orientation: "vertical"
            elevation: 20
            md_bg_color: 1, 0, 0, 1
            size_hint_x: .9
            size_hint_y: .6
            pos_hint: {'center_x': .5, 'center_y': .35}
            opacity: .2
            radius: [30]